# Build artifacts / 构建产物
release/
*.exe
!test/**/*.exe
fg-qimen
fg-qimen.exe

# Go workspace / Go 工作区
*.test
coverage.txt
*.cover
coverage.out
# Per-package coverprofiles from go test -coverprofile=PATH.
# The default name (coverage.out) is what ci.yml uses; explicit
# paths (e.g. /tmp/cov.out) don't need a rule.
# / per-package coverprofile 从 go test -coverprofile=PATH。
# 默认名（coverage.out）是 ci.yml 用的；显式路径
# （如 /tmp/cov.out）不需要规则。

# Scan-run outputs (gitignored) / 扫描运行产物（gitignored）
runs/

# Test data (committed) lives under test/ — do NOT ignore.
# Test 数据（提交进仓库）放在 test/ —— 不要忽略。

# IDE / 编辑器
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude / agent tooling (local settings, per-machine permissions)
# Claude / agent 工具配置（本机权限设置）
.claude/

# Logs / 日志
*.log

# Local environment / 本地环境
.env
.env.local

# Trae IDE / 编辑器
.trae/

# Accidental artifact directory / 意外产物目录
binary=release/
